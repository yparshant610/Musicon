# ============================================================
# DISCORD CONFIGURATION
# ============================================================
DISCORD_TOKEN=your_discord_bot_token_here

# ============================================================
# SPOTIFY API CONFIGURATION
# ============================================================
Client_ID=your_spotify_client_id_here
Client_secret=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# ============================================================
# YOUTUBE COOKIE SETTINGS (RECOMMENDED FOR 24/7 HOSTING)
# ============================================================
# Path to your exported Netscape cookies file (relative or absolute)
YOUTUBE_COOKIE_FILE=youtube_cookies.txt

# Optional: Read cookies directly from a local browser profile (e.g., chrome, edge, firefox)
# Leave unset when using YOUTUBE_COOKIE_FILE or deploying to EC2/cloud VPS
YOUTUBE_BROWSER=
